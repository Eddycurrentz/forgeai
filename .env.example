# Application
APP_NAME=forgeai
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL (async driver used by the API)
DATABASE_URL=postgresql+asyncpg://forgeai:forgeai@localhost:5432/forgeai

# PostgreSQL (sync driver used by Alembic)
DATABASE_URL_SYNC=postgresql+psycopg://forgeai:forgeai@localhost:5432/forgeai

# Redis
REDIS_URL=redis://localhost:6379/0

# Compose service credentials
POSTGRES_USER=forgeai
POSTGRES_PASSWORD=forgeai
POSTGRES_DB=forgeai
POSTGRES_PORT=5432
REDIS_PORT=6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
